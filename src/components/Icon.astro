---
interface Props {
  name: 'github' | 'linkedin' | 'mail' | 'file' | 'arrow-right' | 'arrow-left' | 'arrow-up-right' | 'sun' | 'moon' | 'play' | 'pause' | 'close' | 'copy' | 'check';
  size?: number;
}
const { name, size = 16 } = Astro.props;
---

