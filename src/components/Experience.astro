---
import { experience } from '../data/site';

const month = (ym: string) => new Date(`${ym}-01T00:00:00Z`);
const fmt = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const range = (start: string, end: string) => fmt.formatRange(month(start), month(end));
---

<section class="section container" id="experience" aria-labelledby="exp-title">
  <div class="section-head" data-reveal>
    <div>
      <p class="eyebrow">Experience</p>
      <h2 id="exp-title">Where I’ve Worked</h2>
    </div>
    <p>Co-op and internship terms, oldest to most recent.</p>
  </div>

  <div class="timeline" data-timeline>
    <div class="rail" aria-hidden="true"><span class="rail-fill"></span></div>
    <ol>
      {experience.map((job) => (
        <li class:list={['stop', { current: 'current' in job && job.current }]}>
          <span class="node" aria-hidden="true"></span>
          <p class="dates mono">
            <time datetime={job.start}>{range(job.start, job.end)}</time>
            {'current' in job && job.current && <span class="now">Current</span>}
          </p>
          <h3>{job.company}</h3>
          <p class="role">{job.role}</p>
          <p class="team">{job.team}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline { position: relative; }
  .rail { position: absolute; left: 0; right: 0; top: 7px; height: 2px; background: var(--line); border-radius: 2px; overflow: hidden; }
  .rail-fill { position: absolute; inset: 0; background: var(--accent); transform-origin: left; }
  ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px); list-style: none; margin: 0; padding: 0; }
  .stop { position: relative; padding-top: 36px; }
  .node {
    position: absolute; left: 0; top: 0; width: 16px; height: 16px; border-radius: 50%;
    background: var(--bg); border: 2px solid var(--accent);
  }
  .current .node { background: var(--accent); }
  .current .node::after {
    content: ''; position: absolute; inset: -6px; border-radius: 50%; border: 2px solid var(--accent); opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .current .node::after { animation: ping 2.4s var(--ease-out) infinite; }
  }
  @keyframes ping {
    0% { transform: scale(0.6); opacity: 0.7; }
    80%, 100% { transform: scale(1.6); opacity: 0; }
  }
  .dates { display: flex; align-items: center; gap: 10px; margin: 0 0 10px; color: var(--muted); }
  .now {
    font-size: 0.625rem; padding: 3px 7px; border-radius: 999px; background: var(--accent-soft); color: var(--accent);
  }
  h3 { font-size: clamp(1.75rem, 3vw, 2.4rem); letter-spacing: -0.04em; margin-bottom: 10px; }
  .role { margin: 0 0 2px; font-weight: 600; color: var(--ink); }
  .team { margin: 0; color: var(--muted); }

  @media (max-width: 760px) {
    .rail { left: 7px; right: auto; top: 8px; bottom: 8px; width: 2px; height: auto; }
    .rail-fill { transform-origin: top; }
    ol { grid-template-columns: 1fr; gap: 36px; }
    .stop { padding: 0 0 0 40px; }
  }

  /* Draw-on state: hidden only with JS + motion allowed */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .timeline:not(.is-drawn) .rail-fill { transform: scaleX(0); }
    :global(.js) .timeline:not(.is-drawn) .stop { opacity: 0; transform: translateY(14px); }
    :global(.js) .timeline:not(.is-drawn) .node { transform: scale(0); }
  }
  @media (prefers-reduced-motion: no-preference) and (max-width: 760px) {
    :global(.js) .timeline:not(.is-drawn) .rail-fill { transform: scaleY(0); }
  }
</style>
